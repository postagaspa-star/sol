<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Milestone 2: chiamate a Claude. Già dichiarato per non toccare più il manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SolApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_sol"
        android:allowBackup="false"
        android:theme="@style/Theme.Sol">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- L'orecchio di Sol: microfono dichiarato come tipo di servizio,
             obbligatorio da Android 14 per l'accesso in primo piano. -->
        <service
            android:name=".ascolto.AscoltoService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".ascolto.TileOrecchio"
            android:exported="true"
            android:icon="@drawable/ic_sol"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".ascolto.AvvioDopoRiavvio"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
